<mxfile host="drawio" version="24.7.0"><diagram id="batterymind-delivery" name="batterymind-delivery"><mxGraphModel dx="1900" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="810" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;BatteryMind — build, deployment and hosting&lt;/b&gt;&lt;br&gt;Every release path is reviewed and reproducible. The AWS stack is deployed on demand and torn down afterward to avoid charges." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1840" height="50" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Manisha / agent&lt;/b&gt;&lt;br&gt;commits to GitHub (main)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="90" as="geometry"/></mxCell><mxCell id="gh" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;public; no raw data, credentials or caches." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="260" height="90" as="geometry"/></mxCell><mxCell id="g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="dev" target="gh" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_ci" value="GitHub Actions · CI on every push and pull request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;fontColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="1210" height="190" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Static checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;ruff lint and format; docs page in sync with gate files and reports." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="280" height="135" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Tests&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unit, security, API and memory tests; PostgreSQL + pgvector tests in a container; CDK assertions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="975" y="130" width="280" height="135" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Real-data reproducibility&lt;/b&gt;&lt;br&gt;&lt;br&gt;Download the NASA archive, verify SHA-256, re-run ingestion and the exports." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="130" width="280" height="135" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Build and browser test&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build the app and showcase; drive the built showcase in headless Chrome." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1565" y="130" width="280" height="135" as="geometry"/></mxCell><mxCell id="g2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="gh" target="g_ci" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_deploy" value="Deployment targets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;fontColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="1840" height="250" as="geometry"/></mxCell><mxCell id="manual" value="&lt;b&gt;AWS (manual, reviewed)&lt;/b&gt;&lt;br&gt;Operator runs &lt;i&gt;cdk diff&lt;/i&gt;, reviews it, then &lt;i&gt;cdk deploy&lt;/i&gt;. The GitHub OIDC deploy role is blocked by an AWS Organizations policy, so the deploy workflow cannot run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E1;strokeColor=#ED7100;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="300" height="170" as="geometry"/></mxCell><mxCell id="cfn" value="AWS CloudFormation&lt;br&gt;stack BatteryMindDemo" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="64" height="64" as="geometry"/></mxCell><mxCell id="ecr" value="Amazon ECR&lt;br&gt;immutable ARM64 tags" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="64" height="64" as="geometry"/></mxCell><mxCell id="fargate" value="ECS Fargate&lt;br&gt;API and ingestion" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="64" height="64" as="geometry"/></mxCell><mxCell id="vercel" value="&lt;b&gt;Vercel&lt;/b&gt; · batterymind-app&lt;br&gt;React chat app, calls the AWS API when it is running. Deployed with the Vercel CLI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1130" y="390" width="360" height="80" as="geometry"/></mxCell><mxCell id="vercel2" value="&lt;b&gt;Vercel&lt;/b&gt; · batterymind-showcase&lt;br&gt;static export, never depends on AWS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1130" y="490" width="360" height="70" as="geometry"/></mxCell><mxCell id="pages" value="&lt;b&gt;GitHub Pages&lt;/b&gt;&lt;br&gt;explainer page, architecture diagrams and video from DOC/. Published by a manually dispatched workflow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1530" y="390" width="320" height="170" as="geometry"/></mxCell><mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="manual" target="cfn" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="cfn" target="ecr" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ecr" target="fargate" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="h1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="gh" target="manual" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="310"/><mxPoint x="200" y="310"/></Array></mxGeometry></mxCell><mxCell id="h2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="gh" target="pages" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="322"/><mxPoint x="1690" y="322"/></Array></mxGeometry></mxCell><mxCell id="g_state" value="Release state and cost control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;fontColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1840" height="140" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;Validated&lt;/b&gt;: image v14 on AWS us-east-2 — live suite 24 of 24 checks, 4 of 4 X-Ray traces, Fargate ingestion matching committed evidence. &lt;b&gt;Torn down&lt;/b&gt; on 2026-11-06 to remove charges; checks found no remaining stack, bucket, repository, user pool, database, snapshot, load balancer or log group. &lt;b&gt;Always available at no cost&lt;/b&gt;: GitHub, GitHub Pages and both Vercel sites. &lt;b&gt;Reprovisioning&lt;/b&gt; follows docs/runbooks/deployment.md and requires Manisha&#x27;s authorization; the CDK pins Region us-east-2 and in-region Bedrock models only. &lt;b&gt;Cost&lt;/b&gt;: an 8-hour demonstration is estimated at $2.95 of fixed charges and about $60.80 per month if left running (reports/cost)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="1800" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>