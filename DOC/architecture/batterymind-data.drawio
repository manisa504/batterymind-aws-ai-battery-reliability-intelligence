<mxfile host="drawio" version="24.7.0"><diagram id="batterymind-data" name="batterymind-data"><mxGraphModel dx="1900" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;BatteryMind — data ingestion and promotion pipeline&lt;/b&gt;&lt;br&gt;Real NASA Ames measurements are verified, transformed deterministically, and promoted only when they reproduce the committed evidence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1840" height="50" as="geometry"/></mxCell><mxCell id="nasa" value="&lt;b&gt;NASA Ames archive&lt;/b&gt;&lt;br&gt;public S3 object, 209,668,106 bytes. Cells B0005, B0006, B0007, B0018." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="90" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;sends a versioned ingestion request as an SQS message." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="sqs" value="Amazon SQS + DLQ&lt;br&gt;3 receives, then dead-letter" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="pipe" value="EventBridge Pipe&lt;br&gt;batch size 1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge_pipes;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="task" value="ECS Fargate task&lt;br&gt;2 vCPU · 8 GB · ARM64" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="1150" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="s3" value="S3 data bucket&lt;br&gt;encrypted, TLS only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1500" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="op" target="sqs" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="sqs" target="pipe" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="pipe" target="task" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="task" target="s3" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="nasa" target="task" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="70"/><mxPoint x="1182" y="70"/></Array></mxGeometry></mxCell><mxCell id="g_steps" value="Inside the ingestion task (packages/ingestion/worker.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;fontColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1840" height="250" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1 · Download and verify&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fetch the archive (size-bounded) and compare SHA-256 and byte count with data/manifests/nasa-source.json. A mismatch fails the run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="340" height="190" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2 · Preserve the original&lt;/b&gt;&lt;br&gt;&lt;br&gt;Store the unchanged archive at raw/nasa/&amp;lt;sha256&amp;gt;.zip. Original laboratory files are never modified." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="415" y="340" width="340" height="190" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;3 · Parse and transform&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read the MATLAB cells and write deterministic Parquet: cycles, samples, impedance, plus a data-quality report. Nothing is filled or simulated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="340" width="340" height="190" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;4 · Compare with evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compare each output hash with reports/data_quality/nasa-ingestion.json, which is committed to Git." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1145" y="340" width="340" height="190" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;5 · Promote or refuse&lt;/b&gt;&lt;br&gt;&lt;br&gt;If every hash matches, copy to processed/current/. Otherwise the run is marked FAIL and nothing is promoted. Status is written to processed/runs/&amp;lt;run_id&amp;gt;/status.json." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1510" y="340" width="340" height="190" as="geometry"/></mxCell><mxCell id="p1p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="p1" target="p2" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="p2" target="p3" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="p3" target="p4" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4p5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="p4" target="p5" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_use" value="What consumes the data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;fontColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1840" height="200" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;FastAPI service&lt;/b&gt;&lt;br&gt;On startup it loads processed/current/cycles.parquet from S3 (falling back to the copy baked into the image) and serves analytics: capacity, SOH, RUL baseline, decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="650" width="520" height="130" as="geometry"/></mxCell><mxCell id="export" value="&lt;b&gt;Showcase export&lt;/b&gt; (scripts/export_showcase.py)&lt;br&gt;Builds the versioned JSON from the same Parquet. CI regenerates it and requires the derived values to match within 1e-9." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="650" width="520" height="130" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;Continuous integration&lt;/b&gt;&lt;br&gt;Downloads the real archive, verifies the recorded SHA-256, re-runs ingestion, and fails if the Parquet hashes differ from the committed report. Raw data and Parquet are never committed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1190" y="650" width="640" height="130" as="geometry"/></mxCell><mxCell id="u1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="p5" target="api" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="580"/><mxPoint x="310" y="580"/></Array></mxGeometry></mxCell><mxCell id="u2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="p5" target="export" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="580"/><mxPoint x="880" y="580"/></Array></mxGeometry></mxCell><mxCell id="u3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="p5" target="ci" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="580"/><mxPoint x="1510" y="580"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>