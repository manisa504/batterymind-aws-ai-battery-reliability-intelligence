="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f15" value="15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="github" target="ecr" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="628"/><mxPoint x="380" y="882"/></Array></mxGeometry></mxCell><mxCell id="f16" value="16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;dashed=1;" edge="1" source="github" target="pages" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f17" value="17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;dashed=1;" edge="1" source="nasa" target="s3data" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f18" value="18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ingest" target="vercel_showcase" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="768"/><mxPoint x="45" y="388"/></Array></mxGeometry></mxCell><mxCell id="f19" value="19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" source="ingest" target="sqs" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="782"/><mxPoint x="1480" y="782"/><mxPoint x="1480" y="572"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Request path (solid)&lt;/b&gt;&lt;br&gt;1 Engineer opens the app · 2 Sign-in: Cognito hosted UI, authorization code + PKCE, authenticator-app MFA · 3 API calls with the Cognito ID token (CORS limited to the app origin) · 4 Web assets for the AWS-hosted UI · 5 CloudFront forwards /api/* over HTTP to an ALB that accepts only CloudFront origin addresses · 6 ALB to Fargate tasks · 7 API verifies the token signature with Cognito JWKS · 8 Sessions, assessments, conversation turns and embeddings, as a non-bypass role under row-level security · 9 Chat (Gemma 3 12B) and embeddings (Titan Text Embeddings V2), both on-demand in us-east-2 · 10 Database credentials · 11 Queue-triggered ingestion task · 12 promoted data access · 14 logs, metrics and alarms&lt;br&gt;&lt;b&gt;Build and data preparation (dashed)&lt;/b&gt;&lt;br&gt;13 Image pull · 15 Container image build/push (workflow defined; demo images were pushed manually) · 16 Documentation publish · 17 Verified NASA archive preserved in S3 · 18 Static JSON export for the showcase · 19 Operator submits a versioned ingestion request" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="1090" width="1740" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>