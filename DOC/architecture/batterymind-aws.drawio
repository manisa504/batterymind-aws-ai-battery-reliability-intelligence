" y="218"/><mxPoint x="1425" y="218"/><mxPoint x="1425" y="922"/></Array></mxGeometry></mxCell><mxCell id="f11" value="11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="operator" target="sqs" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f12" value="12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="sqs" target="pipe" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f13" value="13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="pipe" target="ingest" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f14" value="14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ingest" target="s3data" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="802" y="642"/></Array></mxGeometry></mxCell><mxCell id="f18" value="18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" source="nasa" target="ingest" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="818" y="862"/></Array></mxGeometry></mxCell><mxCell id="f19" value="19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.69;entryY=1;entryDx=0;entryDy=0;" edge="1" source="ecr" target="g_pub" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f20" value="20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="github" target="ecr" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="722"/><mxPoint x="420" y="982"/></Array></mxGeometry></mxCell><mxCell id="f21" value="21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="github" target="pages" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Request and data flows (solid)&lt;/b&gt;&lt;br&gt;1 Engineer opens the Vercel app · 2 Sign-in through the Cognito hosted UI (authorization code + PKCE, authenticator-app MFA) · 3 The app calls the API with the Cognito ID token (CORS limited to the app origin) · 4 AWS-hosted web assets · 5 CloudFront forwards /api/* over HTTP to a load balancer that accepts only CloudFront origin addresses · 6 Load balancer to the Fargate API · 7 The API verifies tokens against Cognito&#x27;s signing keys · 8 Sessions, assessments, conversation turns and embeddings in PostgreSQL/pgvector, queried as a non-bypass role under row-level security · 9 Chat (Gemma 3 12B) and embeddings (Titan Text Embeddings V2), both on-demand in us-east-2 · 10 Database credentials · 12–13 SQS to an EventBridge Pipe that starts the ingestion task · 14 The task verifies the NASA archive hash, stores the raw archive and Parquet outputs, and promotes them only if they match committed evidence · 15 The API reads promoted data · 16 OpenTelemetry spans via a CloudWatch agent sidecar · 17 Logs, metrics and alarms&lt;br&gt;&lt;b&gt;Operator, build and publishing flows (dashed)&lt;/b&gt;&lt;br&gt;11 Operator request · 18 NASA archive download · 19 Image pull · 20 Image build and push (the deploy workflow exists, but an AWS Organizations policy blocks the OIDC role, so images were pushed manually) · 21 Documentation publish. The API and ingestion tasks run in public subnets with public IPs because the design avoids a NAT gateway; security groups admit only the load balancer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="1150" width="2150" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>