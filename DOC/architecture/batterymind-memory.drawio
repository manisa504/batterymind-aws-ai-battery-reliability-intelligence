<mxfile host="drawio" version="24.7.0"><diagram id="batterymind-memory" name="batterymind-memory"><mxGraphModel dx="1700" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="940" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;BatteryMind — AI memory and retrieval pipeline&lt;/b&gt;&lt;br&gt;One chat request, from sign-in to stored memory. Structured measurements are always authoritative; vector search only chooses which earlier assessments to recall." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1640" height="50" as="geometry"/></mxCell><mxCell id="cognito" value="Amazon Cognito&lt;br&gt;ID token, MFA" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="160" y="90" width="64" height="64" as="geometry"/></mxCell><mxCell id="s3data" value="S3 · promoted Parquet&lt;br&gt;measured capacity, cycles" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="930" y="90" width="64" height="64" as="geometry"/></mxCell><mxCell id="rds" value="RDS PostgreSQL + pgvector&lt;br&gt;sessions · assessments · turns · embeddings" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="64" height="64" as="geometry"/></mxCell><mxCell id="bedrock_g" value="Amazon Bedrock&lt;br&gt;Gemma 3 12B (chat)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="460" y="700" width="64" height="64" as="geometry"/></mxCell><mxCell id="bedrock_t" value="Amazon Bedrock&lt;br&gt;Titan Text Embeddings V2" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1330" y="690" width="64" height="64" as="geometry"/></mxCell><mxCell id="rds2" value="RDS PostgreSQL&lt;br&gt;row-level security" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="64" height="64" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1 · Authenticate and authorize&lt;/b&gt;&lt;br&gt;&lt;br&gt;The API verifies the Cognito ID token signature, issuer, audience and expiry. The user id scopes every query." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="340" height="150" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2 · Resolve battery and session&lt;/b&gt;&lt;br&gt;&lt;br&gt;The session must belong to this user and to the requested battery; otherwise the request is refused (404)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="340" height="150" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3 · Retrieve authoritative evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Measured discharge capacity, derived SOH, deterministic decision and RUL come from structured data at the chosen cycle cutoff." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="250" width="340" height="150" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4 · Recall prior assessments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Embed the question, then pgvector cosine search over this user&#x27;s valid assessments for the battery up to the cutoff (top 8), plus the 5 most recent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="250" width="340" height="150" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5 · Rank&lt;/b&gt;&lt;br&gt;&lt;br&gt;score = 0.45 relevance + 0.25 recency + 0.20 importance + 0.10 confidence. Importance follows the decision severity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="480" width="340" height="150" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6 · Compress to budget&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evidence is kept in full; ranked memories are added until a 5,000-character context budget is reached." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="480" width="340" height="150" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7 · Generate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gemma 3 12B answers from the evidence block and the last 6 turns. Rules: label values measured, derived or predicted; cite assessment ids; refuse to invent numbers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="340" height="150" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8 · Store&lt;/b&gt;&lt;br&gt;&lt;br&gt;Both turns are saved with model id, token counts and latency. New assessments are saved with their embedding for later recall." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="340" height="150" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s2" target="s3" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s3" target="s4" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s4" target="s5" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s5" target="s6" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s6" target="s7" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s7" target="s8" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cognito" target="s1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s3data" target="s3" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" source="rds" target="s4" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s4" target="bedrock_t" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="325"/><mxPoint x="1650" y="722"/></Array></mxGeometry></mxCell><mxCell id="b7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s7" target="bedrock_g" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#545B64;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#545B64;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s8" target="rds2" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_mem" value="Three kinds of memory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;fontColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="1640" height="125" as="geometry"/></mxCell><mxCell id="mem" value="&lt;b&gt;Short-term&lt;/b&gt; — the last 6 chat turns of the session (chat_turns). &lt;b&gt;Episodic&lt;/b&gt; — saved assessments with the cutoff, decision, policy version, evidence and validity (valid, superseded or deleted). &lt;b&gt;Semantic&lt;/b&gt; — a 1,024-dimension Titan embedding per assessment in pgvector. &lt;b&gt;Authoritative data&lt;/b&gt; — NASA measurements and calculated metrics in structured storage, never replaced by retrieved text. Per-user isolation is enforced twice: query filters and forced row-level security through a non-bypass database role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="828" width="1620" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>